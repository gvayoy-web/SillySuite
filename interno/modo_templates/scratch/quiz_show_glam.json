{
  "id": "quiz_show_glam",
  "title": "Quiz Show Glam",
  "description": "Estilo programa de television con efectos dramaticos, transiciones cinematograficas, iluminacion dinamica y animaciones de camara.",
  "tags": [
    "tv",
    "show",
    "dramatico",
    "transiciones",
    "iluminacion"
  ],
  "difficulty": "dificil",
  "heads": {
    "on_mode_init": [
      {
        "opcode": "set_custom_theme",
        "args": {
          "BG": "#0a0a0f",
          "TXT": "#f8f6f0",
          "ACC": "#FF5E3A",
          "FNT": "'Segoe UI', system-ui, sans-serif"
        },
        "next": {
          "opcode": "set_gradient_bg",
