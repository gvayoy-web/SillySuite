                                                        "next": {
                                                          "opcode": "play_sfx",
                                                          "args": {
                                                            "FILE": "airhorn.mp3",
                                                            "VOL": 70,
                                                            "PITCH": false
                                                          },
                                                          "next": {
                                                            "opcode": "spawn_particle_emitter",
                                                            "args": {
                                                              "KIND": "gold",
                                                              "X": 50,
                                                              "Y": 50
                                                            },
                                                            "next": {
                                                              "opcode": "play_css_animation",
                                                              "args": {
                                                                "COMP": "titulo-principal",
                                                                "ANIM": "shake"
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
