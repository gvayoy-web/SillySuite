                                                      "opcode": "wait_seconds",
                                                      "args": {
                                                        "SEC": 1
                                                      },
                                                      "next": {
                                                        "opcode": "set_text_smooth",
                                                        "args": {
                                                          "COMP": "titulo-principal",
                                                          "TXT": "A JUGAR!"
