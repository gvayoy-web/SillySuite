                            "next": {
                              "opcode": "wait_seconds",
                              "args": {
                                "SEC": 15
                              },
                              "next": {
                                "opcode": "quiz_lock_answers",
                                "args": {},
                                "next": {
                                  "opcode": "play_sfx",
                                  "args": {
                                    "FILE": "buzzer.mp3",
                                    "VOL": 80,
                                    "PITCH": false
                                  },
                                  "next": {
                                    "opcode": "set_text_smooth",
                                    "args": {
                                      "COMP": "titulo-principal",
                                      "TXT": "TIEMPO!"
                                    },
                                    "next": {
                                      "opcode": "play_css_animation",
                                      "args": {
                                        "COMP": "titulo-principal",
                                        "ANIM": "shake"
                                      },
                                      "next": {
                                        "opcode": "set_gradient_bg",
                                        "args": {
                                          "DIR": "→",
                                          "C1": "#2d0a0a",
                                          "C2": "#0a0a0f"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
