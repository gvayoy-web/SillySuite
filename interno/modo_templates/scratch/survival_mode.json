{
  "id": "survival_mode",
  "title": "Modo Supervivencia",
  "description": "Eliminacion progresiva. Ultimo en pie gana. Incluye strikes y lockouts.",
  "tags": [
    "supervivencia",
    "eliminacion",
    "competitivo"
  ],
  "difficulty": "dificil",
  "heads": {
    "on_mode_init": [
      {
        "opcode": "set_gradient_bg",
        "args": {
          "DIR": "↓",
          "C1": "#0d0d0d",
          "C2": "#1a0000"
        },
        "next": {
          "opcode": "set_custom_theme",
          "args": {
            "BG": "transparent",
            "TXT": "#ff6b6b",
            "ACC": "#ff4444",
            "FNT": "monospace"
          },
          "next": {
            "opcode": "quiz_init_engine",
            "args": {
              "N": 30,
              "CAT": "mixed"
            },
            "next": {
              "opcode": "db_query_filter_difficulty",
              "args": {
                "D": "dificil"
              },
              "next": {
                "opcode": "db_query_exclude_last_questions",
                "args": {
                  "N": 3
                },
                "next": {
                  "opcode": "players_set_active_slots",
                  "args": {
                    "N": 6
                  },
                  "next": {
                    "opcode": "state_init_memory_key",
                    "args": {
                      "KEY": "ronda",
                      "DEF": 1
                    },
                    "next": {
                      "opcode": "state_init_memory_key",
                      "args": {
                        "KEY": "jugadores_vivos",
                        "DEF": 6
                      },
                      "next": {
                        "opcode": "show_variable",
                        "args": {
                          "VAR": "jugadores_vivos",
                          "DISP": "display-principal"
                        },
                        "next": {
                          "opcode": "show_variable",
                          "args": {
                            "VAR": "ronda",
                            "DISP": "display-principal"
                          },
                          "next": {
                            "opcode": "set_text_smooth",
                            "args": {
                              "COMP": "titulo-principal",
                              "TXT": "MODO SUPERVIVENCIA"
                            },
                            "next": {
                              "opcode": "set_text_smooth",
                              "args": {
                                "COMP": "subtitulo",
                                "TXT": "6 jugadores - 3 strikes = eliminacion"
                              },
                              "next": {
                                "opcode": "play_bg_music",
                                "args": {
                                  "FILE": "suspense.mp3",
                                  "VOL": 45,
                                  "LOOP": true
                                },
                                "next": {
                                  "opcode": "spawn_particle_emitter",
                                  "args": {
                                    "KIND": "fire",
                                    "X": 50,
                                    "Y": 10
                                  },
                                  "next": {
                                    "opcode": "play_sfx",
                                    "args": {
                                      "FILE": "sword-clash.mp3",
                                      "VOL": 70,
                                      "PITCH": false
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ],
    "on_question_start": [
      {
        "opcode": "quiz_fetch_next_question",
        "args": {},
        "next": {
          "opcode": "state_increment_memory",
          "args": {
            "KEY": "ronda",
            "BY": 1
          },
          "next": {
            "opcode": "set_text_smooth",
            "args": {
              "COMP": "pregunta-texto",
              "TXT": "Ronda de supervivencia"
            },
            "next": {
              "opcode": "play_sfx",
              "args": {
                "FILE": "drumroll.mp3",
                "VOL": 55,
                "PITCH": false
              },
              "next": {
                "opcode": "spawn_particle_emitter",
                "args": {
                  "KIND": "fire",
                  "X": 50,
                  "Y": 30
                },
                "next": {
                  "opcode": "set_text_smooth",
                  "args": {
                    "COMP": "titulo-principal",
                    "TXT": "RONDA"
                  },
                  "next": {
                    "opcode": "wait_seconds",
                    "args": {
                      "SEC": 10
                    },
                    "next": {
                      "opcode": "quiz_lock_answers",
                      "args": {},
                      "next": {
                        "opcode": "play_sfx",
                        "args": {
                          "FILE": "buzzer.mp3",
                          "VOL": 80,
                          "PITCH": false
                        },
                        "next": {
                          "opcode": "set_text_smooth",
                          "args": {
                            "COMP": "titulo-principal",
                            "TXT": "TIEMPO!"
                          },
                          "next": {
                            "opcode": "play_css_animation",
                            "args": {
                              "COMP": "titulo-principal",
                              "ANIM": "shake"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ],
    "on_player_answer": [
      {
        "opcode": "quiz_verify_player_answer",
        "args": {
          "PLAYER": "current"
        },
        "next": {
          "opcode": "quiz_add_score_to_player",
          "args": {
            "PLAYER": "current",
            "PTS": 15
          },
          "next": {
            "opcode": "set_text_smooth",
            "args": {
              "COMP": "subtitulo",
              "TXT": "SOBREVIVES! +15 pts"
            },
            "next": {
              "opcode": "play_sfx",
              "args": {
                "FILE": "correct.mp3",
                "VOL": 80,
                "PITCH": false
              },
              "next": {
                "opcode": "spawn_particle_emitter",
                "args": {
                  "KIND": "gold",
                  "X": 50,
                  "Y": 30
                },
                "next": {
                  "opcode": "play_css_animation",
                  "args": {
                    "COMP": "titulo-principal",
                    "ANIM": "flash"
                  }
                }
              }
            }
          }
        }
      }
    ],
    "on_player_buzz": [
      {
        "opcode": "players_strike_penalize",
        "args": {
          "PLAYER": "current"
        },
        "next": {
          "opcode": "set_text_smooth",
          "args": {
            "COMP": "subtitulo",
            "TXT": "STRIKE! Fallo registrado"
          },
          "next": {
            "opcode": "play_sfx",
            "args": {
              "FILE": "strike.mp3",
              "VOL": 85,
              "PITCH": false
            },
            "next": {
              "opcode": "play_css_animation",
              "args": {
                "COMP": "titulo-principal",
                "ANIM": "shake"
              },
              "next": {
                "opcode": "spawn_particle_emitter",
                "args": {
                  "KIND": "fire",
                  "X": 50,
                  "Y": 50
                }
              }
            }
          }
        }
      }
    ],
    "on_timer_expire": [
      {
        "opcode": "players_toggle_lockout",
        "args": {
          "PLAYER": "slowest",
          "ON": true
        },
        "next": {
          "opcode": "state_increment_memory",
          "args": {
            "KEY": "eliminaciones",
            "BY": 1
          },
          "next": {
            "opcode": "set_text_smooth",
            "args": {
              "COMP": "titulo-principal",
              "TXT": "ELIMINADO!"
            },
            "next": {
              "opcode": "play_sfx",
              "args": {
                "FILE": "elimination.mp3",
                "VOL": 90,
                "PITCH": false
              },
              "next": {
                "opcode": "play_css_animation",
                "args": {
                  "COMP": "titulo-principal",
                  "ANIM": "shake"
                },
                "next": {
                  "opcode": "spawn_particle_emitter",
                  "args": {
                    "KIND": "fire",
                    "X": 50,
                    "Y": 40
                  },
                  "next": {
                    "opcode": "set_text_smooth",
                    "args": {
                      "COMP": "subtitulo",
                      "TXT": "Un jugador ha sido eliminado"
                    },
                    "next": {
                      "opcode": "trigger_scene_wipe",
                      "args": {
                        "WIPE": "slide"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}