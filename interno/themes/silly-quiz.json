  "shapes": {
    "count": 20,
    "opacity": 0.08,
    "speed": 1.0,
    "behavior": "float"
  },
  "timer": {
    "style": "circle",
    "size": 100,
    "position": "top-right",
    "bgColor": "rgba(0,0,0,0.6)",
    "textColor": "#FFFFFF",
    "progressColor": "#8B5CF6",
    "glowColor": "rgba(139, 92, 246, 0.3)",
    "urgentColor": "#FF4444",
    "animation": "pulse"
  },
  "scores": {
    "position": "bottom",
    "height": 280
  },
  "decorations": {
    "showLogo": true,
    "showShapes": true,
    "showParticles": true
  }
