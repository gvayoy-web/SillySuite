{
  "id": "silly-quiz",
  "name": "SillyQuiz Flagship",
  "category": "modern",
  "description": "Tema flagship de SillyQuiz - azul vibrante con acentos púrpura",
  "colors": {
    "primary": "#3B82F6",
    "primaryLight": "#60A5FA",
    "primaryDark": "#2563EB",
    "secondary": "#64748B",
    "accent": "#8B5CF6",
    "accentLight": "#A78BFA",
    "accentDark": "#7C3AED",
    "success": "#10B981",
    "successLight": "#34D399",
    "warning": "#F59E0B",
    "warningLight": "#FBBF24",
    "danger": "#EF4444",
    "dangerLight": "#F87171",
    "info": "#0EA5E9",
    "bgPrimary": "#050510",
    "bgSecondary": "#0A0A15",
    "bgTertiary": "#13132A",
    "bgHover": "#0F0F1F",
    "bgActive": "#15152F",
    "textPrimary": "#E2E8F0",
    "textSecondary": "#94A3B8",
    "textMuted": "#64748B",
    "textInverse": "#0F172A",
    "borderColor": "#2A2A4A",
    "borderLight": "#3A3A5A",
    "borderLighter": "#4A4A6A"
